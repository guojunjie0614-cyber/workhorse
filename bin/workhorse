#!/usr/bin/env bash
# workhorse: hand a task to Codex like a subagent. The task text comes on stdin; the short report goes to stdout.
#   workhorse [-C dir | -w name] [-n name] [--code|--review|--ops] [-m model] [-e effort] [--detach] <<'EOF' ... EOF   new job
#   workhorse -r [name] [--code] [--detach] <<'EOF' ... EOF    follow-up in the same Codex thread (default: last job; --code turns a review into a fix)
#   workhorse -l | workhorse -t [name] | workhorse -k [name]      list jobs | what a job is doing | stop a job
#   workhorse --clean name                          remove the worktree and branch that `-w name` created
set -uo pipefail

# Maximum characters in status activity and command summaries.
readonly SUMMARY_CHARS=60
# Number of recent commands included in status JSON.
readonly LAST_CMDS=5
# Maximum jobs shown by the list command.
readonly LIST_LIMIT=20
# Name column width in list output.
readonly LIST_NAME_WIDTH=30
# Number of command lines shown by the tail command.
readonly TAIL_CMDS=8
# Maximum characters per command line in tail output.
readonly CMD_CHARS=200
# Maximum diff stat lines included in reports.
readonly DIFF_LINES=15
# Maximum error log lines included in reports.
readonly LOG_TAIL_LINES=20
# Seconds to wait for a detached job to start.
readonly DETACH_WAIT_SECONDS=5
# Maximum error log lines shown when detach fails.
readonly DETACH_LOG_TAIL_LINES=10
# Seconds between detached startup checks.
readonly DETACH_POLL_SECONDS=0.01
# Seconds per minute for elapsed and idle durations.
readonly SECONDS_PER_MINUTE=60

root="${WORKHORSE_HOME:-$HOME/.cache/workhorse}"
mkdir -p "$root"
dir="$PWD" name="" mode="" resume=0 model="" effort="" dir_set=0 wt="" detach=0 uncommitted=0
newest() { ls -t "$root" | grep -v '^LAST$' | head -1; }
alive() { [[ -f "$1/pid" ]] && kill -0 "$(cat "$1/pid")" 2>/dev/null; }
base_of() {
  if [[ -f "$root/$1/base.txt" ]]; then cat "$root/$1/base.txt"
  else
    local base; base="$(printf '%s\n' "$1" | sed -E 's/(\.[0-9]+)+$//')"
    if [[ -d "$root/$base" ]]; then printf '%s\n' "$base"; else printf '%s\n' "$1"; fi
  fi
}
latest() { ls -dt "$root/$1" "$root/$1".* 2>/dev/null | head -1; }
resolve() {
  local base last_run; base="$(base_of "$1")"
  if [[ "$1" == "$base" ]]; then last_run="$(latest "$base")"; else last_run="$root/$1"; fi
  printf '%s\n' "${last_run:-$root/$1}"
}
tree() { local c; for c in $(pgrep -P "$1"); do tree "$c"; done; echo "$1"; }
# Snapshot the whole working tree (untracked files included) through a throwaway index; the real index is untouched.
snap() { local idx; idx="$(mktemp)"; rm -f "$idx"
  GIT_INDEX_FILE="$idx" git -C "$1" add -A :/ 2>/dev/null && GIT_INDEX_FILE="$idx" git -C "$1" write-tree; rm -f "$idx"; }
# Default regular expression identifying test commands.
readonly TESTS='(^|&&|\|\||[;\n])\s*([A-Za-z_][A-Za-z_0-9]*=[^\s]+\s+)*([^\s;&|]*/)?((python[0-9.]*\s+-m\s+)?(pytest|py\.test|unittest)|(npm|pnpm|yarn|bun)\s+(run\s+)?test|vitest|jest|go\s+test|cargo\s+test|ctest|make\s+(check|test)|tox|nox|rspec)(\s|$|[;&|])'
COMMAND_JQ='
  def command_body:
    if test("^/bin/(zsh|bash) -lc ") then
      sub("^/bin/(zsh|bash) -lc "; "") | sub("^[\u0027\"]"; "") | sub("[\u0027\"]$"; "")
    else . end |
    split("\u0027\\\u0027\u0027") | join("\u0027") |
    split("\u0027\"\u0027\"\u0027") | join("\u0027") |
    split("\\\"") | join("\"");
  def command_display: command_body | (split("\n")[0] // "") | .[:$summary_chars];
  def is_test: command_body | test($tests);
'

config_file="${XDG_CONFIG_HOME:-$HOME/.config}/workhorse/config"
if [[ -f "$config_file" ]]; then
  while IFS='=' read -r key value || [[ -n "$key" ]]; do
    case "$key" in
      WORKHORSE_MODEL_CODE|WORKHORSE_MODEL_REVIEW|WORKHORSE_MODEL_OPS|WORKHORSE_EFFORT_CODE|WORKHORSE_EFFORT_REVIEW|WORKHORSE_EFFORT_OPS|WORKHORSE_FAST_MATCH|WORKHORSE_DISABLE_MCP|WORKHORSE_LANG|WORKHORSE_ALLOW_OPS|WORKHORSE_KEEP_DAYS|WORKHORSE_SKIP_SKILLS|WORKHORSE_TEST_PATTERN)
        [[ ${!key+x} ]] || printf -v "$key" '%s' "$value" ;;
    esac
  done < "$config_file"
fi
: "${WORKHORSE_MODEL_CODE=gpt-6-astra}" "${WORKHORSE_MODEL_REVIEW=gpt-6-astra}" "${WORKHORSE_MODEL_OPS=gpt-6.1-sol}"
: "${WORKHORSE_EFFORT_CODE=medium}" "${WORKHORSE_EFFORT_REVIEW=high}" "${WORKHORSE_EFFORT_OPS=high}"
: "${WORKHORSE_FAST_MATCH=*sol*}" "${WORKHORSE_DISABLE_MCP=node_repl}" "${WORKHORSE_LANG=zh}" "${WORKHORSE_ALLOW_OPS=1}"
: "${WORKHORSE_KEEP_DAYS=14}" "${WORKHORSE_SKIP_SKILLS=karpathy-guidelines,code-review,diagnosing-bugs,tdd}" "${WORKHORSE_TEST_PATTERN=$TESTS}"

case "${1:-}" in
  -h)
    printf '%s\n' \
      'Usage: workhorse [-C dir | -w name] [-n name] [--code|--review|--ops] [-m model] [-e effort] [--detach]' \
      '       workhorse -r [name] [--code] [--detach]' \
      '       workhorse -s [name ...] | -l | -t [name] | -k [name] | --clean name' \
      'Settings (environment > ~/.config/workhorse/config > default):' \
      "  WORKHORSE_KEEP_DAYS=$WORKHORSE_KEEP_DAYS  Cleanup age in days" \
      "  WORKHORSE_SKIP_SKILLS=$WORKHORSE_SKIP_SKILLS  Comma-separated skills; empty omits the rule" \
      "  WORKHORSE_TEST_PATTERN=$TESTS"
    exit 0 ;;
  -s)
    shift
    if (( $# == 0 )); then
      for j in "$root"/*; do
        [[ -d "$j" ]] && { [[ -f "$j/finishing" ]] || { [[ ! -f "$j/report.txt" ]] && alive "$j"; }; } && set -- "$@" "${j##*/}"
      done
    fi
    now=$(date +%s)
    for name in "$@"; do
      j="$(resolve "$name")"; name="${j##*/}"; base="$(base_of "$name")"
      # base.N is round N; a legacy chain like base.2.2.2 counts one round per segment.
      round=1; rest="${name#"$base"}"
      if [[ "$rest" =~ ^\.([0-9]+)$ ]]; then round="${BASH_REMATCH[1]}"
      elif [[ "$rest" =~ ^(\.[0-9]+)+$ ]]; then round=$(( $(tr -cd . <<<"$rest" | wc -c) + 1 )); fi
      if [[ ! -d "$j" ]]; then
        jq -n --arg name "$name" --arg base "$base" --argjson round "$round" '{name: $name, base: $base, round: $round, state: "missing", activity: "", busy: "", busy_min: 0, files: 0}'
        continue
      fi
      report=""
      if [[ -f "$j/finishing" ]]; then state=running
      elif [[ -f "$j/report.txt" ]]; then
        state=done; report=$(head -1 "$j/report.txt")
      elif alive "$j"; then state=running
      else state=dead; fi
      if [[ -f "$j/start" ]]; then started=$(cat "$j/start")
      else started=$(perl -e 'print((stat shift)[9])' "$j"); fi
      log=/dev/null; modified=$started
      if [[ -f "$j/events.jsonl" ]]; then
        log="$j/events.jsonl"
        modified=$(perl -e 'print((stat shift)[9])' "$log")
      fi
      jq -s --arg name "$name" --arg path "$(cd "$j" && pwd)" \
        --arg base "$base" --argjson round "$round" --argjson now "$now" --argjson modified "$modified" \
        --arg dir "$(cat "$j/dir.txt" 2>/dev/null)" \
        --arg state "$state" --arg mode "$(cat "$j/mode.txt" 2>/dev/null)" \
        --arg model "$(cat "$j/model.txt" 2>/dev/null)" --arg effort "$(cat "$j/effort.txt" 2>/dev/null)" \
        --arg report "$report" --arg tests "$WORKHORSE_TEST_PATTERN" --argjson started "$started" \
        --argjson summary_chars "$SUMMARY_CHARS" --argjson last_cmds "$LAST_CMDS" --argjson seconds_per_minute "$SECONDS_PER_MINUTE" \
        --argjson elapsed "$(( (now - started) / SECONDS_PER_MINUTE ))" --argjson idle "$(( (now - modified) / SECONDS_PER_MINUTE ))" "$COMMAND_JQ"'
        [.[] | select(.type == "item.completed" and .item.type == "command_execution")] as $commands |
        ([.[] | select(.type == "item.started" and .item.type == "command_execution")] | last) as $last_command |
        ($last_command != null and (any($commands[]; .item.id == $last_command.item.id) | not)) as $busy |
        [.[] | select(.type | startswith("item.")) | .item] as $items |
        {name: $name, base: $base, round: $round, path: $path, dir: $dir, state: $state, mode: $mode, model: $model, effort: $effort,
         activity: ($items | last | if .type == "file_change" then "Editing " + (.changes[0].path | split("/") | last)
                    elif .type == "command_execution" then (.command // "" | command_display)
                    elif .type == "agent_message" then (.text // "") else "" end | (split("\n")[0] // "") | .[:$summary_chars]),
         files: ([.[] | select(.type == "item.completed" and .item.type == "file_change") | .item.changes[].path] | unique | length),
         exit: (if $state == "done" then ($report | capture(" exit=(?<code>-?[0-9]+) ").code | tonumber) else null end),
         started: $started, elapsed_min: $elapsed, idle_min: $idle,
         busy: (if $busy then ($last_command.item.command | command_display) else "" end),
         busy_min: (if $busy then (($now - ($last_command.workhorse_time // $modified)) / $seconds_per_minute | floor | if . < 0 then 0 else . end) else 0 end),
         cmds: ($commands | length),
         tests: ([$commands[] | select(.item.command | is_test)] | length),
         tokens: (map(select(.type == "turn.completed") | .usage.input_tokens + .usage.output_tokens) | add // 0),
         last_cmds: ([.[] | select(.type == "item.started" and .item.type == "command_execution") | .item.command] | .[-$last_cmds:]),
         report: (if $state == "done" then $report else null end)}' < <(jq -c -R 'fromjson? // empty' "$log")
    done | jq -s '.'
    exit 0 ;;
  -l)
    for d in $(ls -t "$root" | grep -v '^LAST$' | head -n "$LIST_LIMIT"); do
      j="$root/$d"
      if [[ -f "$j/report.txt" ]]; then st="$(head -1 "$j/report.txt" | cut -d' ' -f3-)"
      elif alive "$j"; then
        if [[ -f "$j/start" ]]; then started=$(cat "$j/start")
        else started=$(perl -e 'print((stat shift)[9])' "$j/codex.log"); fi
        st="running $(( ($(date +%s) - started) / SECONDS_PER_MINUTE ))min"
      else st="dead (no report)"; fi
      printf '%-*s %s\n' "$LIST_NAME_WIDTH" "$d" "$st"
    done; exit 0 ;;
  -t)
    j="$(resolve "${2:-$(newest)}")"
    cmds=0 tests=0 log="$j/codex.log"
    if [[ -f "$j/events.jsonl" ]]; then
      log="$j/events.jsonl"
      jq -r 'select(.type == "item.started" and .item.type == "command_execution") | .item.command' "$log" | tail -n "$TAIL_CMDS" | cut -c"1-$CMD_CHARS"
      cmds=$(jq -s '[.[] | select(.type == "item.completed" and .item.type == "command_execution")] | length' "$log")
      tests=$(jq -s --arg tests "$WORKHORSE_TEST_PATTERN" --argjson summary_chars "$SUMMARY_CHARS" "$COMMAND_JQ"'[.[] | select(.type == "item.completed" and .item.type == "command_execution") | select(.item.command | is_test)] | length' "$log")
    fi
    if [[ -f "$j/start" ]]; then started=$(cat "$j/start")
    else started=$(perl -e 'print((stat shift)[9])' "$j/codex.log"); fi
    now=$(date +%s)
    echo "-- $cmds commands, $tests test runs," \
         "$(( (now - started) / SECONDS_PER_MINUTE ))min elapsed," \
         "last output $(( (now - $(perl -e 'print((stat shift)[9])' "$log")) / SECONDS_PER_MINUTE ))min ago$(alive "$j" || echo ', not running')"; exit 0 ;;
  -k)
    j="$(resolve "${2:-$(newest)}")"
    alive "$j" || { echo "not running"; exit 0; }
    kill -TERM $(tree "$(cat "$j/pid")") 2>/dev/null; echo "stopped $(basename "$j")"; exit 0 ;;
  --clean)
    j="$root/${2:?usage: workhorse --clean name}"; w="$(cat "$j/worktree.txt" 2>/dev/null)"
    [[ -n "$w" ]] || { echo "workhorse: job '$2' has no worktree" >&2; exit 2; }
    main="$(cat "$j/repo.txt")"
    branch="$(cat "$j/branch.txt" 2>/dev/null || echo "workhorse/$2")"
    git -C "$main" merge-base --is-ancestor "$branch" HEAD || { echo "workhorse: branch $branch is not merged into $(git -C "$main" branch --show-current); merge it first" >&2; exit 2; }
    git -C "$main" worktree remove "$w" && git -C "$main" branch -d "$branch"; exit $? ;;
esac

while IFS= read -r -d '' j; do
  [[ -f "$j/pid" || -f "$j/finishing" ]] && continue
  [[ -f "$j/worktree.txt" && -e "$(cat "$j/worktree.txt")" ]] && continue
  rm -rf "$j"
done < <(find "$root" -mindepth 1 -maxdepth 1 -type d -mtime +"$WORKHORSE_KEEP_DAYS" -print0)

while [[ $# -gt 0 ]]; do
  case "$1" in
    -C) dir="$2"; dir_set=1; shift 2 ;;
    -w) wt="$2"; shift 2 ;;
    -n) name="$2"; shift 2 ;;
    -r) resume=1; [[ -n "${2:-}" && "$2" != -* ]] && { name="$2"; shift; }; shift ;;
    --code|--review|--ops) mode="${1#--}"; shift ;;
    -m) model="$2"; shift 2 ;;
    -e) effort="$2"; shift 2 ;;
    --detach) detach=1; shift ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

(( detach )) && root="$(cd "$root" && pwd)"
task="$(cat)"
[[ -n "${task// }" ]] || { echo "workhorse: task text goes on stdin" >&2; exit 2; }

session="" prev_mode=""
if (( resume )); then
  name="${name:-$(cat "$root/LAST" 2>/dev/null)}"; base="$(base_of "$name")"; prev="$root/$base"
  for j in "$prev" "$prev".*; do
    [[ -d "$j" ]] && { [[ -f "$j/finishing" ]] || alive "$j"; } && { echo "workhorse: $(basename "$j") is still running; wait for it or workhorse -k it first" >&2; exit 2; }
  done
  last_run="$(latest "$base")"
  session="$(cat "$last_run/session.txt" 2>/dev/null)"
  [[ -n "$session" ]] || { echo "workhorse: no session for job '$name'" >&2; exit 2; }
  [[ -f "$last_run/lang.txt" ]] && WORKHORSE_LANG="$(cat "$last_run/lang.txt")"
  prev_mode="$(cat "$last_run/mode.txt")"
  (( dir_set )) || dir="$(cat "$last_run/dir.txt")"
  : "${mode:=$prev_mode}"
  [[ "$mode" == "$prev_mode" ]] && { : "${model:=$(cat "$last_run/model.txt" 2>/dev/null)}"; : "${effort:=$(cat "$last_run/effort.txt" 2>/dev/null)}"; }
  n=2
  for j in "$prev".*; do
    [[ -d "$j" ]] || continue
    round="${j#"$prev."}"
    [[ "$round" =~ ^[0-9]+$ ]] && (( 10#$round >= n )) && n=$((10#$round + 1))
  done
  out="$prev.$n"
else
  if [[ -n "$wt" ]]; then
    top="$(git -C "$dir" rev-parse --show-toplevel)" || exit 2
    main="$(dirname "$(git -C "$top" rev-parse --path-format=absolute --git-common-dir)")"
    uncommitted=$(git -C "$main" status --porcelain=v1 | wc -l | tr -d ' ')
    dir="$(dirname "$main")/$(basename "$main")-$wt"
    [[ -d "$dir" ]] || git -C "$top" worktree add -q "$dir" -b "workhorse/$wt" || exit 2
    branch="$(git -C "$dir" branch --show-current)"
    name="${name:-$wt}"
  fi
  dir="$(cd "$dir" && pwd)" || exit 2
  name="${name:-$(basename "$dir")-$(date +%m%d-%H%M%S)}"
  out="$root/$name"
  base="$name"
  [[ -e "$out" ]] && { echo "workhorse: job '$name' already exists; pick another -n or use -r" >&2; exit 2; }
fi
: "${mode:=code}"
[[ "$mode" == ops && "$WORKHORSE_ALLOW_OPS" == 0 ]] && { echo "workhorse: --ops is disabled by WORKHORSE_ALLOW_OPS=0" >&2; exit 2; }
mkdir -p "$out"
echo "${out##*/}" > "$root/LAST"
printf '%s\n' "$base" > "$out/base.txt"
printf '%s\n' "$dir" > "$out/dir.txt"; printf '%s\n' "$mode" > "$out/mode.txt"
[[ -n "$wt" ]] && { printf '%s\n' "$dir" > "$out/worktree.txt"; printf '%s\n' "$main" > "$out/repo.txt"; printf '%s\n' "$branch" > "$out/branch.txt"; }
isgit=0; [[ "$mode" != review ]] && git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 && { isgit=1; pre="$(snap "$dir")"; }

case "$mode" in
  code)   sandbox=workspace-write;    : "${model:=$WORKHORSE_MODEL_CODE}"; deff="$WORKHORSE_EFFORT_CODE" ;;
  review) sandbox=read-only;          : "${model:=$WORKHORSE_MODEL_REVIEW}"; deff="$WORKHORSE_EFFORT_REVIEW" ;;
  ops)    sandbox=danger-full-access; : "${model:=$WORKHORSE_MODEL_OPS}"; deff="$WORKHORSE_EFFORT_OPS" ;;
  *) echo "mode must be code|review|ops" >&2; exit 2 ;;
esac
# Matching models use the Fast tier with high default reasoning.
tier=default
[[ $model == $WORKHORSE_FAST_MATCH ]] && { tier=fast; deff=high; }
: "${effort:=$deff}"
printf '%s\n' "$model" > "$out/model.txt"; printf '%s\n' "$effort" > "$out/effort.txt"
printf '%s\n' "$WORKHORSE_LANG" > "$out/lang.txt"

if [[ "$WORKHORSE_LANG" == en ]]; then
  case "$mode" in
    code) scope="You may modify files within $dir." ;;
    review) scope="Read-only: do not modify any files; provide only conclusions and evidence." ;;
    ops) scope="You may access files outside the repository and other machines (deployment, remote execution, etc.), only as required by the task." ;;
  esac
  follow_up="The preceding action_safety, verification_loop, default_follow_through_policy, and compact_output_contract rules remain in effect."
else
  case "$mode" in
    code) scope="可以修改 $dir 内的文件。" ;;
    review) scope="只读：不修改任何文件，只给出结论和证据。" ;;
    ops) scope="可以访问仓库外的文件和其他机器（部署、远程运行等），限于任务所需。" ;;
  esac
  follow_up="前面给出的 action_safety、verification_loop、default_follow_through_policy、compact_output_contract 仍然有效。"
fi

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd "$(dirname "$script_path")" && pwd)"
  script_path="$(readlink "$script_path")"
  [[ "$script_path" == /* ]] || script_path="$script_dir/$script_path"
done
script_dir="$(cd "$(dirname "$script_path")" && pwd)"

# Block layout follows OpenAI's own Codex prompting guide (codex plugin for Claude Code).
# A follow-up in the same mode only sends the new task: the thread already has the rules.
{
  printf '<task>\n%s\n</task>\n' "$task"
  if [[ "$mode" == "$prev_mode" ]]; then
    printf '\n%s\n' "$follow_up"
  else
    blocks="$(< "$script_dir/../prompts/blocks.$WORKHORSE_LANG.md")"
    if [[ -z "$WORKHORSE_SKIP_SKILLS" ]]; then
      blocks="$(printf '%s\n' "$blocks" | sed '/{{SKIP_SKILLS}}/d')"
    else
      blocks="${blocks//\{\{SKIP_SKILLS\}\}/$WORKHORSE_SKIP_SKILLS}"
    fi
    blocks="${blocks//\{\{SCOPE\}\}/$scope}"
    blocks="${blocks//\{\{OUT\}\}/$out}"
    printf '\n%s\n' "$blocks"
  fi
} > "$out/prompt.md"

cfg=(-c "model=\"$model\"" -c "model_reasoning_effort=\"$effort\"" -c "service_tier=\"$tier\"" -c "sandbox_mode=\"$sandbox\""
     -c "notify=[]")
read -r -a disabled_mcp <<< "$WORKHORSE_DISABLE_MCP"
for mcp in ${disabled_mcp[@]+"${disabled_mcp[@]}"}; do cfg+=(-c "mcp_servers.$mcp.enabled=false"); done
[[ $sandbox == workspace-write ]] && cfg+=(-c "sandbox_workspace_write.network_access=true"
                                          -c "sandbox_workspace_write.writable_roots=[\"$out\"]")

run_job() {
start=$(date +%s)
printf '%s\n' "$start" > "$out/start"
(
  if [[ -n "$session" ]]; then
    (cd "$dir" && exec codex exec resume "${cfg[@]}" --json --skip-git-repo-check -o "$out/final.md" "$session" - \
       < "$out/prompt.md" 2> "$out/codex.log")
  else
    codex exec "${cfg[@]}" -C "$dir" --json --skip-git-repo-check -o "$out/final.md" - < "$out/prompt.md" 2> "$out/codex.log"
  fi | jq -c -R --unbuffered 'fromjson? // empty | . + {workhorse_time: now}' > "$out/events.jsonl"
) &
echo $! > "$out/pid"
wait $!; rc=$?
touch "$out/finishing"

sid="$(jq -r 'select(.type == "thread.started") | .thread_id' "$out/events.jsonl")"
printf '%s\n' "${sid:-$session}" > "$out/session.txt"
{
  echo "== $(basename "$out") exit=$rc $mode $model/$effort/$tier $(( ($(date +%s) - start + SECONDS_PER_MINUTE - 1) / SECONDS_PER_MINUTE ))min" \
       "$(jq -sr '[.[] | select(.type == "turn.completed") | .usage] | "tokens=\(map(.input_tokens - (.cached_input_tokens // 0) + .output_tokens) | add // 0) cached=\(map(.cached_input_tokens // 0) | add // 0)"' "$out/events.jsonl") cmds=$(jq -s '[.[] | select(.type == "item.completed" and .item.type == "command_execution")] | length' "$out/events.jsonl")" \
       "tests=$(jq -s --arg tests "$WORKHORSE_TEST_PATTERN" --argjson summary_chars "$SUMMARY_CHARS" "$COMMAND_JQ"'[.[] | select(.type == "item.completed" and .item.type == "command_execution") | select(.item.command | is_test)] | length' "$out/events.jsonl")"
  [[ -n "$session" && -n "$sid" && "$sid" != "$session" ]] && echo "!! resume started a new thread; context did not carry over"
  (( rc )) && tail -n "$LOG_TAIL_LINES" "$out/codex.log"
  cat "$out/final.md" 2>/dev/null; echo
  if (( isgit )) && [[ -n "$pre" ]]; then
    post="$(snap "$dir")"
    if [[ "$pre" == "$post" ]]; then echo "(no file changes)"
    else git -C "$dir" diff --stat "$pre" "$post" | tail -n "$DIFF_LINES"; fi
  fi
  [[ -n "$wt" ]] && echo "worktree: $dir (branch $branch)"
} | if (( detach )); then cat > "$out/report.tmp"; else tee "$out/report.tmp"; fi
mv "$out/report.tmp" "$out/report.txt"
rm -f "$out/finishing" "$out/pid"
exit "$rc"
}

if (( detach )); then
  perl -MPOSIX -e '
    POSIX::setsid();
    for (glob "/dev/fd/*") { m{/(\d+)$}; POSIX::close($1) if $1 > 2; }
    exec @ARGV;
  ' bash -u -o pipefail -c "$(declare -p dir out session cfg mode model effort tier isgit wt WORKHORSE_TEST_PATTERN COMMAND_JQ detach SUMMARY_CHARS LOG_TAIL_LINES DIFF_LINES SECONDS_PER_MINUTE
               [[ -n "$wt" ]] && declare -p branch
               (( isgit )) && declare -p pre
               declare -f snap run_job
               echo run_job)" < /dev/null > /dev/null 2>&1 &
  deadline=$((SECONDS + DETACH_WAIT_SECONDS))
  while [[ ! -f "$out/pid" && ! -f "$out/report.txt" ]]; do
    if (( SECONDS >= deadline )); then
      echo "workhorse: detached job failed to start" >&2
      [[ -f "$out/codex.log" ]] && tail -n "$DETACH_LOG_TAIL_LINES" "$out/codex.log" >&2
      exit 1
    fi
    sleep "$DETACH_POLL_SECONDS"
  done
  printf 'started %s %s\n' "$(basename "$out")" "$out"
  (( uncommitted )) && printf 'warning: %s uncommitted changes in %s are not in the worktree\n' "$uncommitted" "$main"
  exit 0
fi
run_job
